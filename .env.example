# ============================================================
# Variables d'environnement pour Docker Compose
# IMPORTANT : Ne JAMAIS committer ce fichier dans Git !
# Copiez .env.example vers .env et remplissez vos valeurs
# ============================================================

# Mot de passe de la base de données H2 (laisser vide si pas de mot de passe)
DB_PASSWORD=

# Clé API Gemini (NE PAS laisser dans application.properties !)
GEMINI_API_KEY=VOTRE_CLE_API_ICI

# Activer la console H2 (false en production, true en dev)
H2_CONSOLE_ENABLED=false

# Profil Spring Boot (prod | dev)
SPRING_PROFILES_ACTIVE=prod
